{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shmoney",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_EMAILS": "josephlove076@gmail.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shmoney",
      "database_id": "29be106f-6efe-4893-8f27-4861c68cc473",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    "crons": ["0 11 * * *"]
  }
}
